# =============================================================
# Alexi v2 — Personal Project Coach
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# LLM — Qwen3.5 via Nosana Inference Endpoint
OPENAI_API_KEY=nosana
OPENAI_BASE_URL=https://YOUR_NOSANA_ENDPOINT.node.k8s.prd.nos.ci/v1
OPENAI_SMALL_MODEL=Qwen/Qwen3.5-4B
OPENAI_LARGE_MODEL=Qwen/Qwen3.5-4B

# Embedding — Nosana-hosted
OPENAI_EMBEDDING_URL=https://YOUR_NOSANA_EMBEDDING_ENDPOINT.node.k8s.prd.nos.ci/v1
OPENAI_EMBEDDING_API_KEY=nosana
OPENAI_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
OPENAI_EMBEDDING_DIMENSIONS=1024

# Agent Server
SERVER_PORT=3000

# Web Search (get free key at tavily.com)
TAVILY_API_KEY=

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Notion Integration (create at notion.so/my-integrations)
NOTION_API_KEY=
NOTION_DATABASE_ID=
